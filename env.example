# Copy to .env in this folder. The real key stays on the Python backend.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Verified against official docs on 2026-10-29; change if the provider changes it.
DEEPSEEK_MODEL=deepseek-flash
AGENT_MAX_ROUNDS=4
AGENT_MAX_TOKENS=1800
AGENT_TIMEOUT_SECONDS=45

# Local demo database. Relative paths are resolved from agent_backend/.
LIBRARY_DATA_MODE=demo
DATABASE_PATH=data/library_demo.sqlite3

# Future authorized library data service, following DATABASE_API.md.
# Switch LIBRARY_DATA_MODE to http after the service adapter is ready.
LIBRARY_API_BASE_URL=
LIBRARY_API_TOKEN=

